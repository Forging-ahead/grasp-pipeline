              "robot_state",
              "configuration",
              "task_definition",
              "simulator_truth",
              "estimation",
              "memory",
              "code_policy"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "types",
        "evidence",
        "description"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
